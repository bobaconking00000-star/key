-- ===== CHECK KEY =====
local function checkKeyOnline(inputKey)
    local ok, result = pcall(function()
        return game:HttpGet(KEY_URL)
    end)
    if ok then return inputKey == result:gsub("%s+", "") end
    return false
end

-- ===== LOAD CHILLI (STEALTH + RETRY) =====
local function loadChilli()
    for attempt = 1, 3 do
        local ok, source = pcall(game.HttpGet, game, SCRIPT_URL)
        if ok and type(source) == "string" and source ~= "" then
            local chunk = loadstring(source)
            if chunk then
                pcall(chunk)
            end
            return true
        end
        task.wait(0.5)
    end
    return false
end

