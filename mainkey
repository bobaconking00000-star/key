-- ==========================================
getgenv().AntiKickMax = true
local mt = getrawmetatable(game)

local function showKickBlocked()
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "🛡️",
            Text = "Kick blocked",
            Duration = 2,
        })
    end)
end

if not getgenv().AntiKickLoaded then
    getgenv().AntiKickLoaded = true

    setreadonly(mt, false)
    local old_namecall = mt.__namecall

    -- LỚP 1: Hook __namecall chặn Kick/Ban/Detected
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if self == LocalPlayer and (method == "Kick" or method:lower():find("kick") or method:lower():find("ban") or method:lower():find("detected")) then
            showKickBlocked()
            return
        end

        if method == "FireServer" and (tostring(self):find("Kick") or tostring(self):find("Ban") or tostring(self):find("exploit") or tostring(self):find("detected")) then
            showKickBlocked()
            return
        end

        if method == "Disconnect" and self == LocalPlayer then
            showKickBlocked()
            return
        end

        return old_namecall(self, ...)
    end)

    -- LỚP 2: Hook trực tiếp hàm Kick
    if hookfunction then
        pcall(function()
            hookfunction(LocalPlayer.Kick, function() showKickBlocked() end)
        end)
    end

    -- LỚP 3: Ghi đè hàm error()
    local old_error = error
    error = function(msg, level)
        local s = tostring(msg):lower()
        if s:find("kick") or s:find("exploit") or s:find("ban") or s:find("detected") or #tostring(msg) > 1000 then
            showKickBlocked()
            return
        end
        return old_error(msg, level)
    end

    -- LỚP 4-7: Re-hook loop + Disable Idled
    task.spawn(function()
        while task.wait(0.15) do
            pcall(function()
                for _, c in ipairs(getconnections(LocalPlayer.Idled)) do
                    c:Disable()
                end
            end)

            pcall(function()
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if self == LocalPlayer and (method:lower():find("kick") or method:lower():find("detected")) then
                        showKickBlocked()
                        return
                    end
                    return old_namecall(self, ...)
                end)
                setreadonly(mt, true)
            end)
        end
    end)

    setreadonly(mt, true)
    print("✅ Anti-Kick MAX đã kích hoạt - 7 lớp!")
end

