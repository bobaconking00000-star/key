    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamMedium
    lbl.Parent = toast

    tween(toast, 0.4, {Position = UDim2.new(1, -340, 0, 0)}, Enum.EasingStyle.Back)
    task.delay(2.5, function()
        tween(toast, 0.3, {Position = UDim2.new(1, 400, 0, 0)})
