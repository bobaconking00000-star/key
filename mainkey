local function createStyledButton(name, text, pos, size, c1, c2, parent)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = c1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Parent = parent
    addCorner(btn, 8)
    addGradient(btn, c1, c2, 90)
    local stroke = addStroke(btn, Color3.fromRGB(255,255,255), 1)
    stroke.Transparency = 0.75

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.TextPrimary
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        tween(btn, 0.2, {Size = UDim2.new(size.X.Scale, size.X.Offset, size.Y.Scale, size.Y.Offset + 3)})
        tween(stroke, 0.2, {Transparency = 0.3})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.2, {Size = size})
        tween(stroke, 0.2, {Transparency = 0.75})
    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, 0.08, {
            Size = UDim2.new(size.X.Scale, size.X.Offset - 6, size.Y.Scale, size.Y.Offset - 4),
            BackgroundColor3 = Color3.fromRGB(255,255,255)
        })
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, 0.15, {Size = size, BackgroundColor3 = c1})
    end)
    return btn, label
end

