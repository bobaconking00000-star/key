-- ===== FILE I/O =====
local function loadKeys()
    local keys = {}
    if isfile and isfile(FILE_NAME) then
        for line in readfile(FILE_NAME):gmatch("[^\r\n]+") do
            if line ~= "" then table.insert(keys, line) end
        end
    end
    return keys
end

local function saveKeysToFile(keys)
    if writefile then writefile(FILE_NAME, table.concat(keys, "\n")) end
end

